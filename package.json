{
  "name": "hirebit",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "pnpm --filter @hirebit/web dev",
    "dev:api": "pnpm --filter @hirebit/api dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "build": "turbo run build",
    "db:generate": "pnpm --filter @hirebit/api db:generate",
    "db:validate": "pnpm --filter @hirebit/api db:validate"
  },
  "devDependencies": { "turbo": "^2.5.0" }
}
